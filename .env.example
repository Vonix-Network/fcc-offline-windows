# ── Vonix Code Camp — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in values before running.
# .env is gitignored and must NEVER be committed.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB=mongodb://127.0.0.1:27017/vonix_code_camp

# ── Email / SMTP (optional — registration works without it) ──────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@vonix.network
SMTP_PASS=yoursmtppassword

# ── GitHub OAuth (optional — enables "Sign in with GitHub") ──────────────────
GITHUB_ID=your_github_oauth_app_client_id
GITHUB_SECRET=your_github_oauth_app_client_secret

# ── PM2 / Process ─────────────────────────────────────────────────────────────
SERVER_NAME=vonix-code-camp
INSTANCES=1
MAX_MEMORY=512M
