extends layout
block content
    // ── HERO ──────────────────────────────────────────────────────────────
    .vcc-hero
        .vcc-hero-content
            .vcc-hero-badge ✦ Updated for May 2026
            h1.vcc-hero-title
                | Learn to Code
                span.vcc-hero-title-accent  the Right Skills
                | .
            p.vcc-hero-subtitle Master Python, TypeScript, React, AI/ML, SQL, and Security — offline, at your own pace, completely free.
            .vcc-hero-actions
                a.btn.vcc-btn-primary.vcc-btn-lg(href='/signin') Start Learning &rarr;
                a.btn.vcc-btn-ghost.vcc-btn-lg(href='/map') Browse Curriculum
        .vcc-hero-code
            pre.vcc-code-preview
                code
                    | <span class="vcc-kw">const</span> journey = {
                    |   <span class="vcc-prop">skills</span>: [<span class="vcc-str">'Python'</span>, <span class="vcc-str">'TypeScript'</span>, <span class="vcc-str">'AI'</span>],
                    |   <span class="vcc-prop">projects</span>: <span class="vcc-num">300</span><span class="vcc-str">+</span>,
                    |   <span class="vcc-prop">started</span>: <span class="vcc-kw">new</span> Date()
                    | };

    // ── STATS BAR ──────────────────────────────────────────────────────────
    .vcc-stats-bar
        .vcc-stats-item
            span.vcc-stat-number 8
            span.vcc-stat-label Certifications
        .vcc-stats-divider
        .vcc-stats-item
            span.vcc-stat-number 300+
            span.vcc-stat-label Coding Challenges
        .vcc-stats-divider
        .vcc-stats-item
            span.vcc-stat-number 2026
            span.vcc-stat-label Curriculum
        .vcc-stats-divider
        .vcc-stats-item
            span.vcc-stat-number 100%
            span.vcc-stat-label Offline &amp; Free

    // ── COURSE CATALOG ─────────────────────────────────────────────────────
    .vcc-section
        .vcc-section-header
            h2.vcc-section-title Our Curriculum Tracks
            p.vcc-section-subtitle Eight certification paths from beginner to advanced — all runnable offline
        .vcc-course-grid

            .vcc-course-card
                .vcc-course-icon.vcc-icon-orange 🌐
                .vcc-course-meta
                    span.vcc-course-badge Foundational
                h3.vcc-course-name Responsive Web Design
                p.vcc-course-desc Master HTML5, CSS3, Flexbox, and Grid. Build beautiful, responsive layouts from scratch.
                .vcc-course-footer
                    span.vcc-course-time ⏱ ~300 hrs
                    a.vcc-course-link(href='/map') Start &rarr;

            .vcc-course-card
                .vcc-course-icon.vcc-icon-yellow 📜
                .vcc-course-meta
                    span.vcc-course-badge Foundational
                h3.vcc-course-name JavaScript Algorithms
                p.vcc-course-desc ES6+, data structures, algorithms, functional programming, and OOP patterns.
                .vcc-course-footer
                    span.vcc-course-time ⏱ ~300 hrs
                    a.vcc-course-link(href='/map') Start &rarr;

            .vcc-course-card
                .vcc-course-icon.vcc-icon-blue 🐍
                .vcc-course-meta
                    span.vcc-course-badge New 2026
                h3.vcc-course-name Python &amp; Data Science
                p.vcc-course-desc Python fundamentals, NumPy, Pandas, data cleaning, normalization, and scientific computing.
                .vcc-course-footer
                    span.vcc-course-time ⏱ ~200 hrs
                    a.vcc-course-link(href='/map') Start &rarr;

            .vcc-course-card.vcc-card-featured
                .vcc-course-icon.vcc-icon-purple 🤖
                .vcc-course-meta
                    span.vcc-course-badge.vcc-badge-hot 🔥 Hot 2026
                h3.vcc-course-name AI &amp; Modern Web
                p.vcc-course-desc TypeScript, React Hooks, Next.js, LLMs, prompt engineering, RAG, and AI agent patterns.
                .vcc-course-footer
                    span.vcc-course-time ⏱ ~250 hrs
                    a.vcc-course-link(href='/map') Start &rarr;

            .vcc-course-card
                .vcc-course-icon.vcc-icon-teal 🗄️
                .vcc-course-meta
                    span.vcc-course-badge New 2026
                h3.vcc-course-name Relational Databases
                p.vcc-course-desc SQL fundamentals, PostgreSQL, schema design, JOINs, transactions, and ACID guarantees.
                .vcc-course-footer
                    span.vcc-course-time ⏱ ~150 hrs
                    a.vcc-course-link(href='/map') Start &rarr;

            .vcc-course-card
                .vcc-course-icon.vcc-icon-red 🔒
                .vcc-course-meta
                    span.vcc-course-badge New 2026
                h3.vcc-course-name Information Security
                p.vcc-course-desc Password hashing, XSS prevention, JWT auth, rate limiting, and building secure apps.
                .vcc-course-footer
                    span.vcc-course-time ⏱ ~150 hrs
                    a.vcc-course-link(href='/map') Start &rarr;

            .vcc-course-card
                .vcc-course-icon.vcc-icon-green ⚙️
                .vcc-course-meta
                    span.vcc-course-badge Backend
                h3.vcc-course-name Back End Development
                p.vcc-course-desc Node.js, Express, MongoDB, REST APIs, Git, automated testing, and server architecture.
                .vcc-course-footer
                    span.vcc-course-time ⏱ ~300 hrs
                    a.vcc-course-link(href='/map') Start &rarr;

            .vcc-course-card
                .vcc-course-icon.vcc-icon-pink 📊
                .vcc-course-meta
                    span.vcc-course-badge Data Viz
                h3.vcc-course-name Data Visualization
                p.vcc-course-desc D3.js charts, SVG graphics, React data dashboards, and Sass for styling.
                .vcc-course-footer
                    span.vcc-course-time ⏱ ~200 hrs
                    a.vcc-course-link(href='/map') Start &rarr;

    // ── HOW IT WORKS ───────────────────────────────────────────────────────
    .vcc-section.vcc-section-dark
        .vcc-section-header
            h2.vcc-section-title How Vonix Code Camp Works
        .vcc-how-grid
            .vcc-how-step
                .vcc-how-number 01
                h3.vcc-how-title Read the Concept
                p.vcc-how-desc Each challenge starts with a clear explanation of the concept, with code examples showing the real-world pattern.
            .vcc-how-step
                .vcc-how-number 02
                h3.vcc-how-title Write the Code
                p.vcc-how-desc Apply what you learned in an interactive code editor. Your solution runs directly in the browser.
            .vcc-how-step
                .vcc-how-number 03
                h3.vcc-how-title Pass the Tests
                p.vcc-how-desc Automated tests verify your solution. Read the feedback, fix any issues, and level up.
            .vcc-how-step
                .vcc-how-number 04
                h3.vcc-how-title Build Projects
                p.vcc-how-desc Earn each certification by building real projects from scratch. Your portfolio grows as you progress.

    // ── SKILLS ────────────────────────────────────────────────────────────
    .vcc-section
        .vcc-section-header
            h2.vcc-section-title Skills You Will Master
        .vcc-skills-grid
            .vcc-skill-pill.ion-social-html5 HTML5
            .vcc-skill-pill.ion-social-css3 CSS3
            .vcc-skill-pill.ion-social-javascript JavaScript
            .vcc-skill-pill 🐍 Python
            .vcc-skill-pill 📘 TypeScript
            .vcc-skill-pill.ion-social-nodejs Node.js
            .vcc-skill-pill ⚛️ React
            .vcc-skill-pill 🤖 AI / LLMs
            .vcc-skill-pill 🗄️ SQL
            .vcc-skill-pill 🔒 Security
            .vcc-skill-pill.fa.fa-database Databases
            .vcc-skill-pill.ion-social-github Git &amp; GitHub

    // ── FINAL CTA ─────────────────────────────────────────────────────────
    .vcc-cta-section
        h2.vcc-cta-title Ready to start your 2026 coding journey?
        p.vcc-cta-sub Everything runs offline. No internet required after setup.
        a.btn.vcc-btn-primary.vcc-btn-xl(href='/signin') Begin Learning Now &rarr;

    script.
        challengeName = 'Home'
