extends ../layout
block content
    .vcc-auth-wrap
      .vcc-auth-box
        .vcc-auth-logo ✦
        h2.vcc-auth-title Welcome back
        p.vcc-auth-sub Sign in to continue your learning journey.
        form.vcc-auth-form(method='POST', action='/api/users/login')
          input(type='hidden', name='_csrf', value=_csrf)
          .vcc-auth-field
            label.vcc-auth-label(for='email') Email address
            input.vcc-auth-input(type='email', name='email', id='email', placeholder='you@example.com', autofocus=true)
          .vcc-auth-field
            label.vcc-auth-label(for='password') Password
            input.vcc-auth-input(type='password', name='password', id='password', placeholder='Your password')
          button.vcc-auth-btn(type='submit') Sign In
          .vcc-auth-links
            a(href='/forgot') Forgot password?
          p.vcc-auth-switch No account yet?
            a(href='/email-signup')  Create one for free
