extends ../layout
block content
    .vcc-auth-wrap
      .vcc-auth-box
        .vcc-auth-logo ✦
        h2.vcc-auth-title Sign in to Vonix Code Camp
        p.vcc-auth-sub Pick how you’d like to continue.
        .vcc-auth-options
          a.vcc-auth-option-btn(href='/email-signup')
            span.vcc-auth-option-icon ✉
            | Sign up with Email
          a.vcc-auth-option-btn.vcc-auth-option-secondary(href='/email-signin')
            span.vcc-auth-option-icon →
            | Sign in with Email
        .vcc-auth-divider
          span Or continue with
        a.vcc-auth-option-btn.vcc-auth-option-github(href='/auth/github')
          span.vcc-auth-option-icon
            i.fa.fa-github
          | GitHub
