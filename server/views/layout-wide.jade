doctype html
html(lang='en')
  head
    include partials/meta
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Source+Code+Pro:wght@400;600&display=swap')
    include partials/stylesheets
  if showAside
      body.map-aside-body
          include partials/scripts
          block content
  else
      body.no-top-and-bottom-margins(class=theme !== 'default' ? theme : '')
          include partials/scripts
          include partials/navbar
          include partials/flash
          block content
          include partials/footer
          include partials/ai-agent
