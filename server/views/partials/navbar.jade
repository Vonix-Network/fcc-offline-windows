nav.navbar.navbar-default.navbar-fixed-top.vcc-navbar
    .navbar-header
        button.hamburger.navbar-toggle(type='button', data-toggle='collapse', data-target='.navbar-collapse')
            .col-xs-12
                span.hamburger-text Menu
        a.navbar-brand.vcc-brand(href='/')
            span.vcc-logo-icon &#9670;
            span.vcc-logo-text Vonix
            span.vcc-logo-accent &nbsp;Code Camp
    .collapse.navbar-collapse
        ul.nav.navbar-nav.navbar-right.hamburger-dropdown
            li.hidden-xs
                a.vcc-nav-link#nav-map-btn(href='/map' onclick='if (!(event.ctrlKey || event.metaKey)) {return false;}')
                    i.fa.fa-map-o
                    | &nbsp;Curriculum
            li.visible-xs
                a.vcc-nav-link(href='/map')
                    i.fa.fa-map-o
                    | &nbsp;Curriculum
            li.hidden-xs
                a.vcc-nav-link#nav-wiki-btn(href='/wiki' onclick='if (!(event.ctrlKey || event.metaKey)) {return false;}')
                    i.fa.fa-book
                    | &nbsp;Docs
            li.visible-xs
                a.vcc-nav-link(href='/wiki', target='_blank')
                    i.fa.fa-book
                    | &nbsp;Docs
            li
                a.vcc-nav-link(href='/about')
                    i.fa.fa-info-circle
                    | &nbsp;About
            if !user
                li
                    a.btn.vcc-btn-nav(href='/signin') Sign In
            else
                li.brownie-points-nav
                  a.vcc-points-badge(href='/' + user.username)
                    span.vcc-points-icon &#9670;
                    | &nbsp;#{user.points}
                li.hidden-xs.hidden-sm.avatar
                  a(href='/' + user.username)
                        img.profile-picture.float-right(src='#{user.picture}')
